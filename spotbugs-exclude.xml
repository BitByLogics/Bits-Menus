<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Menus, items and data objects are shared handles by design. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Lombok null checks in constructors. -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- clone() builds deep copies through constructors and these classes are not extended. -->
    <Match>
        <Bug pattern="CN_IDIOM_NO_SUPER_CALL"/>
    </Match>

    <!-- Lombok copies @Nullable onto getters, and the flagged code calls the getter again right after a null check on state that is only written during setup. -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
    </Match>
</FindBugsFilter>
